{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris.local/schemas/classification-manifest-v1.json",
  "title": "IRIS classification manifest row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "item_id",
    "relative_path",
    "label",
    "split",
    "source_dataset_id",
    "source_dataset_version",
    "source_group_id",
    "source_event_id",
    "label_basis",
    "license_status",
    "sha256",
    "perceptual_hash",
    "extraction_version",
    "width",
    "height"
  ],
  "properties": {
    "manifest_version": {"const": "iris-classification-manifest-v1"},
    "item_id": {"type": "string", "minLength": 1},
    "relative_path": {"type": "string", "minLength": 1},
    "label": {"enum": ["accident", "non_accident"]},
    "split": {"enum": ["train", "validation", "test", "external_test"]},
    "source_dataset_id": {"type": "string", "minLength": 1},
    "source_dataset_version": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "minLength": 1},
    "source_video_id": {"type": "string"},
    "source_frame_index": {"type": ["integer", "null"], "minimum": 0},
    "source_timestamp_ms": {"type": ["integer", "null"], "minimum": 0},
    "source_reference": {"type": "string"},
    "source_category": {"type": "string"},
    "label_basis": {"type": "string", "minLength": 1},
    "license_status": {"enum": ["APPROVED", "REVIEW_REQUIRED", "RESTRICTED", "PROHIBITED"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "perceptual_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "extraction_version": {"type": "string", "minLength": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "day_night": {"type": "string"},
    "weather": {"type": "string"},
    "ego_involvement": {"type": "string"},
    "accident_category": {"type": "string"}
  }
}
